# 必需：SerpAPI 密钥（找词核心依赖，Google Trends 唯一数据来源）
# 免费申请：https://serpapi.com/ 注册后送 100 次/月（每次运行约用 20-30 次）
# 未配置时降级运行：飙升词产出为 0、量级全部 unknown，所有词将被拦在推荐门槛外
SERPAPI_KEY=

# SerpAPI 月度硬预算与保留额度。普通自动任务最多使用 budget-reserve 次。
SERPAPI_MONTHLY_BUDGET=100
SERPAPI_RESERVE=15

# 可选：配置代理（国内访问 Google 需要）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 每日自动运行时间（cron 格式，默认每天早上 8 点）
CRON_SCHEDULE=0 8 * * *

# 每次随机选取的词根数量
SEEDS_PER_RUN=5

# 每轮最多验证多少个候选词
VERIFY_PER_RUN=20

# ── 雷达模式（radar 命令，双环调度） ──
# 内环每日词根数（24 词根按 2/天 → 12 天轮完）
RADAR_SEEDS_PER_DAY=2

# 外环每轮验证词数（建议每周跑一次，5 词 ≈ 20 额度/月）
RADAR_VERIFY_BATCH=5

# 内环调度：每日 08:00 找词
RADAR_INNER_CRON=0 8 * * *

# 外环调度：每周日 09:00 验证
RADAR_OUTER_CRON=0 9 * * 0

# 观察任务：每日检查到期复查，每轮最多处理 5 个
REVIEW_CRON=0 10 * * *
REVIEW_BATCH=5

# Google Suggest 免费引擎请求间隔(ms)，默认 150
SUGGEST_DELAY=150

# 游戏候选池每轮最多分析几款。所有发现结果都会先入持久化队列，不会因批次上限丢失。
GAME_ANALYSIS_BATCH=5

# 报告输出目录
REPORT_DIR=./reports

# SQLite 数据库文件路径（新词库/需求库/淘汰池）
# 默认: ./data/keywords.db
# DATA_DB_PATH=./data/keywords.db

# 可选：Telegram 推送（创建 bot 后填入）
# 1. Telegram 搜 @BotFather → /newbot 创建机器人 → 拿 BOT_TOKEN
# 2. 给机器人发条消息 → 访问 https://api.telegram.org/bot<TOKEN>/getUpdates 拿 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选：禁用某些数据源（逗号分隔，旧配置项，向后兼容）
# 可选值: reddit, hackernews, sitemap, github, trends
# 例: DISABLE_SOURCES=reddit,github
DISABLE_SOURCES=

# 可选：禁用任意插件（逗号分隔，按插件名禁用）
# 数据源: trends, reddit, hackernews, github, sitemap
# 提取器: ngram
# 分析器: domain, competition, volume-trend, translate
# 评分器: standard-scorer
# 输出:   markdown-report, telegram, sqlite-storage
# 例: DISABLE_PLUGINS=telegram,sitemap
DISABLE_PLUGINS=
