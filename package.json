{
  "name": "keyword-finder",
  "version": "1.0.0",
  "description": "自动找词工具 - 基于哥飞方法论，自动发现新词并验证",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "find": "tsx src/index.ts",
    "find:game": "tsx src/index.ts --category=game",
    "find:ai": "tsx src/index.ts --category=ai",
    "find:all": "tsx src/index.ts --category=all",
    "list": "tsx src/index.ts --list",
    "accept": "tsx src/index.ts accept",
    "reject": "tsx src/index.ts reject",
    "status": "tsx src/index.ts status",
    "watch": "tsx src/index.ts --watch",
    "review": "tsx src/index.ts review",
    "games": "tsx src/index.ts games",
    "test:workflow": "tsx --test test-workflow-state.ts",
    "build": "tsc"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "global-agent": "^4.1.3",
    "https-proxy-agent": "^9.1.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
